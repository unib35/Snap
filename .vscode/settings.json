{
  // SourceKit-LSP Settings
  "sourcekit-lsp.serverPath": "/usr/bin/sourcekit-lsp",
  "sourcekit-lsp.serverArguments": [],

  // Swift Extension Settings
  "swift.path": "/usr/bin/swift",
  "swift.buildPath": "${workspaceFolder}/.build",

  // Editor Settings for Swift
  "[swift]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "sswg.swift-lang",
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.rulers": [120]
  },

  // File Associations
  "files.associations": {
    "*.swift": "swift",
    "Project.swift": "swift",
    "Tuist.swift": "swift"
  },

  // Exclude from Search
  "files.exclude": {
    "**/.build": true,
    "**/Derived": true,
    "**/*.xcodeproj": true,
    "**/*.xcworkspace": true,
    "**/DerivedData": true
  },

  // Search Exclude
  "search.exclude": {
    "**/.build": true,
    "**/Derived": true,
    "**/Tuist/.build": true
  }
}
